# העתק לקובץ בשם .env ושנה מה שצריך. כל השורות אופציונליות.

# פורט השרת
PORT=5178

# מודל התמלול: small (מהיר) | medium (מאוזן) | large-v3 (מדויק, מומלץ לעברית)
CHORDAI_WHISPER_MODEL=large-v3

# שפת ברירת מחדל: he, en, או auto לזיהוי אוטומטי
CHORDAI_LANGUAGE=he

# הפרדת קול מכלים לפני הניתוח. משפר מאוד גם את המילים וגם את האקורדים,
# אבל מוסיף זמן לכל שיר. "false" מכבה.
CHORDAI_SEPARATE=true

# מכשיר להפרדה: mps (מעבד גרפי של אפל) או cpu
CHORDAI_SEPARATION_DEVICE=mps

# גודל העלאה מרבי בבתים (ברירת מחדל 200MB)
# CHORDAI_MAX_UPLOAD=209715200

# נתיבים — רק אם הכלים לא נמצאים ב-PATH
# CHORDAI_PYTHON=/path/to/python
# CHORDAI_YTDLP=/path/to/yt-dlp
# CHORDAI_FFMPEG=/path/to/ffmpeg

# תיקייה לשמירת מודלים של תמלול
# CHORDAI_MODEL_DIR=/path/to/models
