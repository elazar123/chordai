{
  "manifest_version": 3,
  "name": "ChordAI — אקורדים ליוטיוב",
  "description": "תיבה קטנה שמציגה את האקורדים של השיר שמתנגן ביוטיוב, בזמן אמת",
  "version": "1.1.0",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChordAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["chords.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
